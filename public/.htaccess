# Next.js static export (output: "export") served by Apache.
#
# Every route is a real directory with an index.html, because the app was built with
# trailingSlash: true — Apache's default DirectoryIndex resolves them without help.
#
# Detail screens (a job order, a customer, a statement) address their record with a
# query string — /service-tickets/ticket/?id=<uuid> — rather than a path segment, so
# there are no unknown paths to rewrite. A static export cannot pre-render a uuid that
# does not exist at build time, and this keeps the app working on any plain file host.

RewriteEngine On

# Fallback 404
ErrorDocument 404 /404.html

# XAMPP's htdocs ships a default index.php; without this, Apache's
# DirectoryIndex would serve that instead of our app's index.html.
DirectoryIndex index.html
